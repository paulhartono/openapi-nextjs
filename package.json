{
  "name": "openapi-nextjs",
  "version": "0.1.2",
  "description": "Generate Next.js App Router API routes, zod validators, mocks, and TypeScript types from an OpenAPI/Swagger spec.",
  "keywords": [
    "openapi",
    "swagger",
    "nextjs",
    "app-router",
    "codegen",
    "zod",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "author": "Paul Hartono <paul@komuco.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulhartono/openapi-nextjs.git"
  },
  "homepage": "https://github.com/paulhartono/openapi-nextjs#readme",
  "bugs": {
    "url": "https://github.com/paulhartono/openapi-nextjs/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "bin": {
    "openapi-nextjs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.3.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "zod": "^4.0.0"
  }
}
